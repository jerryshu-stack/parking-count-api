# Base URL of the parking API.
#
# Prefer a public HTTPS tunnel over the machine's LAN IP. iOS Wi-Fi Assist moves a
# slow request onto cellular when Wi-Fi is weak, and a private 10.x/192.168.x
# address is unreachable the instant that happens -- which shows up as an upload
# that fails without the server ever seeing a request.
EXPO_PUBLIC_API_BASE_URL=https://your-tunnel.trycloudflare.com

# Device key. Every backend route requires it, including /auth/login, so the app
# cannot reach the API without shipping it. It is embedded in the JS bundle and is
# extractable from any build -- treat it as a device key, not a secret. It grants no
# access to community data on its own; that is gated by the user session.
EXPO_PUBLIC_API_KEY=replace-me
