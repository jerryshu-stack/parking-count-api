# Base URL of the parking API. Use the machine's LAN IP (not 127.0.0.1) when running
# on a physical phone, since the device resolves localhost to itself.
EXPO_PUBLIC_API_BASE_URL=http://10.0.0.246:8000

# Device key. Every backend route requires it, including /auth/login, so the app
# cannot reach the API without shipping it. It is embedded in the JS bundle and is
# extractable from any build -- treat it as a device key, not a secret. It grants no
# access to community data on its own; that is gated by the user session.
EXPO_PUBLIC_API_KEY=replace-me
